# ---- .NET ----
bin/
obj/
*.user
*.suo
.vs/
*.dll
*.pdb

# ---- Node / Next.js ----
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
!.env.*.example

# Local dev settings carry a JWT signing key, DB password and InfluxDB
# token — placeholders today, but per core.txt section 41 they don't
# belong in source control. Copy the .example files to create them.
appsettings.Development.json
!appsettings.Development.json.example
*.pfx
*.pem
*.key
# Anchored patterns containing a slash only match from the repo root, so a
# bare "mosquitto/passwd" would NOT have matched infrastructure/mosquitto/passwd
# — which holds real hashed MQTT credentials.
**/mosquitto/passwd
**/mosquitto/passwd.pre-goauth-backup

# mosquitto.conf (go-auth) has no env-var substitution, so the real
# Postgres password for auth_opt_pg_password has to live in plaintext
# here. Copy mosquitto.conf.example to create it locally.
**/mosquitto/mosquitto.conf

# Generated by infrastructure/mosquitto/certs/generate-dev-certs.sh — the
# script itself stays tracked, its output doesn't (self-signed,
# regenerate locally rather than share).
infrastructure/mosquitto/certs/*.crt
infrastructure/mosquitto/certs/*.key
infrastructure/mosquitto/certs/*.srl

# ---- Docker volumes / data ----
infrastructure/**/data/
# Uploaded firmware binaries (Firmware:StoragePath)
src/backend/Bms.Api/data/
pgdata/
influxdata/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
*.swp

# ---- Logs ----
*.log
logs/
tests/reliability/.generated/

# Local scratch notes holding real MQTT passwords — never commit.
simulators/python-publisher/python text.txt

# Local Mosquitto configuration backups can contain database credentials.
**/mosquitto/mosquitto.conf.bak*
