# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# ---- PostgreSQL ----
POSTGRES_DB=bms_platform
POSTGRES_USER=bms_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- InfluxDB ----
INFLUXDB_ORG=bms-platform
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
INFLUXDB_ADMIN_TOKEN=change-me-influx-admin-token
INFLUXDB_PORT=8086

# ---- Mosquitto ----
# Every MQTT client authenticates (no anonymous access) — see
# infrastructure/mosquitto/passwd.example for how to generate the real
# (git-ignored) password file with one entry per credential below.
MQTT_PORT=1883
MQTTS_PORT=8883
MQTT_BRIDGE_USERNAME=bms-api-realtime-bridge
MQTT_BRIDGE_PASSWORD=change-me
MQTT_INGESTION_USERNAME=bms-ingestion
MQTT_INGESTION_PASSWORD=change-me
# Connector Service (devices that send their own format over TCP). It logs in
# as bms-connectors (write-only to device telemetry topics), and authenticates
# to the API with CONNECTOR_SERVICE_API_KEY — generate one, e.g.
#   openssl rand -base64 32
MQTT_CONNECTORS_PASSWORD=change-me
CONNECTOR_SERVICE_API_KEY=change-me-connector-service-key
# The ports devices connect to. Must match Connectors:PortRangeStart/End.
CONNECTOR_PORT_RANGE=12000-12099
# Used by the simulator (simulators/Bms.DeviceSimulator) and the sample
# publisher (simulators/python-publisher), not by docker-compose. One
# credential per tenant, not one shared "device-sim" credential — the
# username is always the tenant slug (see infrastructure/mosquitto/acl,
# which restricts each one to iot/{tenant-slug}/# only). Password is
# shared across tenants here purely for local-dev convenience.
MQTT_DEVICE_PASSWORD=devicepassword

# ---- MQTT durability (see docs/mqtt/reliability.md "Sizing the broker queue") ----
# How long the broker keeps (and queues for) the ingestion session while
# ingestion is down. Keep MOSQUITTO_PERSISTENT_CLIENT_EXPIRATION >= this.
MQTT_INGESTION_SESSION_EXPIRY_SECONDS=86400
# Per-client queue limits: devices x msgs/s/device x longest outage (s) x safety.
# Size these for YOUR fleet before production — past the limit Mosquitto
# drops QoS 1 messages silently. The defaults below hold roughly 10 minutes
# of outage at 10k devices reporting once a minute, and roughly 60 seconds
# at a 10-second interval. Compute your own:
#   python3 infrastructure/mosquitto/size-queue.py --devices N --interval S --outage 15m
MOSQUITTO_MAX_QUEUED_MESSAGES=100000
MOSQUITTO_MAX_QUEUED_BYTES=104857600
MOSQUITTO_AUTOSAVE_INTERVAL=60
MOSQUITTO_PERSISTENT_CLIENT_EXPIRATION=1d

# ---- ASP.NET Core API ----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ---- Next.js ----
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=http://localhost:5000
WEB_PORT=3000
