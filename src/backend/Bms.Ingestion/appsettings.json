{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "Postgres": ""
  },

  "InfluxDb": {
    "Url": "",
    "Org": "",
    "Bucket": "",
    "Token": "",
    "TimeoutSeconds": 5
  },

  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "ClientId": "bms-ingestion",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 30,
    "TelemetryTopicFilter": "iot/+/+/+/telemetry",
    "HeartbeatTopicFilter": "iot/+/+/+/heartbeat",
    "CommandAckTopicFilter": "iot/+/+/+/commands/ack",
    "SessionExpirySeconds": 86400,
    "ReceiveMaximum": 100,
    "ReconnectMinDelaySeconds": 1,
    "ReconnectMaxDelaySeconds": 30
  },

  "PostgresResilience": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "StartupRetryInitialDelaySeconds": 2,
    "StartupRetryMaxDelaySeconds": 60
  },

  "IngestionReliability": {
    "DuplicateWindowHours": 24,
    "TransientRetryInitialDelayMs": 500,
    "TransientRetryMaxDelaySeconds": 30
  },

  "TimeSeriesBackfill": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "MaxBackoffSeconds": 600,
    "BatchSize": 500,
    "MinAgeSeconds": 120,
    "MaxAttempts": 50
  },

  "RawMessageRetention": {
    "Enabled": true,
    "RetentionDays": 30,
    "IntervalSeconds": 3600,
    "BatchSize": 1000,
    "MaxBatchesPerPass": 50
  },

  "Metrics": {
    "PrometheusPort": 9464
  },

  "IngestionStatus": {
    "HeartbeatSeconds": 15
  },

  "DeviceLifecycle": {
    "SweepIntervalSeconds": 30,
    "OfflineAfterSeconds": 90,
    "NoTelemetryAlertAfterSeconds": 120,
    "DeviceOfflineAlertAfterSeconds": 300,
    "NeverConnectedAlertAfterSeconds": 86400
  },

  "Encryption": {
    "Key": ""
  }
}
