{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  // ApiKey must equal the API's Connectors:ServiceApiKey. Mqtt uses its own
  // login (bms-connectors), allowed to publish to every company's topics.
  "ConnectorService": {
    "ApiBaseUrl": "http://localhost:5000",
    "ApiKey": "",
    "BindAddress": "0.0.0.0",
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "Username": "bms-connectors",
      "Password": "",
      "ClientId": "bms-connectors"
    }
  }
}
