{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "InfluxDb": {
    "Url": "",
    "Org": "",
    "Bucket": "",
    "Token": ""
  },

  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "ClientId": "bms-api-realtime-bridge",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 30,
    // The real-time bridge relays live UI events only: a session that kept
    // queuing them while the API was down would replay stale events, so it
    // stays non-persistent (unlike Bms.Ingestion's).
    "SessionExpirySeconds": 0
  },

  "PostgresResilience": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "StartupRetryInitialDelaySeconds": 2,
    "StartupRetryMaxDelaySeconds": 60
  },

  // Device offline/no-telemetry checks pause while the ingestion service is
  // down, degraded, or draining a backlog (see IngestionHealthTracker).
  "IngestionHealth": {
    "PauseDeviceSilenceChecksWhenUnhealthy": true,
    "StatusTopic": "bms/ingestion/bms-ingestion/status",
    "StaleAfterSeconds": 60,
    "RecoveryGraceSeconds": 180
  },

  "DeviceLifecycle": {
    "SweepIntervalSeconds": 30,
    "OfflineAfterSeconds": 90,
    "NoTelemetryAlertAfterSeconds": 120,
    "DeviceOfflineAlertAfterSeconds": 300,
    "NeverConnectedAlertAfterSeconds": 86400
  },
  "GatewayLifecycle": {
    "SweepIntervalSeconds": 30,
    "OfflineAfterSeconds": 300
  },

  // Firmware over the air. Binaries are stored on this server; devices
  // download them from PublicBaseUrl via a signed link sent over MQTT, so
  // PublicBaseUrl must be reachable from the devices' network.
  "Firmware": {
    "StoragePath": "data/firmware",
    "MaxFileSizeMb": 64,
    "PublicBaseUrl": "http://localhost:5000",
    "DownloadLinkLifetimeMinutes": 60,
    "WaitForDeviceHours": 72,
    "CompletionTimeoutMinutes": 10
  },

  "Jwt": {
    "Issuer": "bms-platform",
    "Audience": "bms-platform",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Encryption": {
    "Key": ""
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  // Connectors: devices that send their own format (raw TCP etc.) through the
  // Connector Service. Ports outside the range are refused; open the range
  // once in the firewall / AWS security group. ServiceApiKey must match the
  // Connector Service's ConnectorService:ApiKey; empty disables its endpoints.
  "Connectors": {
    "PortRangeStart": 12000,
    "PortRangeEnd": 12099,
    "ServiceApiKey": ""
  }
}
